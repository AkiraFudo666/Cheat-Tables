function GetSteamIDs()
   local pipe = io.popen( 'reg query HKCU\\SOFTWARE\\Valve\\Steam\\ActiveProcess /v ActiveUser' )
   if pipe == nil then error( 'Unable to execute command.' ) end
   local ID = string.format( '%d', ( pipe:read( '*all' ) ):match( "0x%x+" ) )
   local tbl = { ID32 = tonumber( ID ), ID64 = tonumber( ID ) + 76561197960265728 }
   return tbl
end
